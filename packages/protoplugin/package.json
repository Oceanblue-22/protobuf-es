{
  "name": "@bufbuild/protoplugin",
  "version": "2.12.0",
  "license": "Apache-2.0",
  "description": "Helps to create your own Protocol Buffers code generators.",
  "keywords": [
    "protobuf",
    "schema",
    "typescript",
    "ecmascript",
    "protoc-plugin"
  ],
  "homepage": "https://protobufes.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bufbuild/protobuf-es.git",
    "directory": "packages/protoplugin"
  },
  "scripts": {
    "build": "tshy",
    "format": "biome format --write",
    "license-header": "license-header",
    "lint": "biome lint --error-on-warnings",
    "attw": "attw --pack"
  },
  "type": "module",
  "sideEffects": false,
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "tshy": "^4.1.3"
  },
  "files": [
    "dist/**"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@bufbuild/protoplugin-transpile": "2.12.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
